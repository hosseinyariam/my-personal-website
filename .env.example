# ══════════════════════════════════════════════════════════════
#  hosseinyariam.ir — پیکربندی محیط توسعه‌ی محلی
#  قاعده: این فایل هرگز وارد مخزن نمی‌شود و بیرون docroot می‌ماند.
# ══════════════════════════════════════════════════════════════

APP_NAME="حسین یاریم"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── دیتابیس: SQLite محلی، MySQL روی هاست ──────────────
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hosseinyariam
# DB_USERNAME=
# DB_PASSWORD=

# ── هاست اشتراکی: بدون Redis، بدون worker ─────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=public

# ── ایمیل: sync + SMTP خارجی (Brevo) ──────────────────
MAIL_MAILER=log
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="hello@hosseinyariam.ir"
MAIL_FROM_NAME="${APP_NAME}"

# ── کاربر مدیر ───────────────────────────────────────
# ADMIN_EMAIL هم سازنده‌ی کاربر مدیر است و هم فهرست مجاز ورود به /admin.
# خالی بودنش یعنی هیچ‌کس به پنل دسترسی ندارد — شکست امن، نه باز.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── فرم تماس ─────────────────────────────────────────
CONTACT_NOTIFY_EMAIL=

# ── آنالیتیکس (Matomo سلف‌هاست، اختیاری) ──────────────
MATOMO_ENABLED=false
MATOMO_URL=
MATOMO_SITE_ID=

# ── هوش مصنوعی: ساختار آماده، در MVP غیرفعال ──────────
AI_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
