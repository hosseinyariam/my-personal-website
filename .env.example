# ══════════════════════════════════════════════════════════════
#  hosseinyariam.ir — پیکربندی محیط
#  قاعده: پیکربندی از env، محتوا فقط از دیتابیس (D04 · روح ۱۲-Factor)
# ══════════════════════════════════════════════════════════════

APP_NAME="حسین یاری"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=https://hosseinyariam.ir

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

# ── دیتابیس (MySQL 8 / MariaDB 10.6+ · utf8mb4) ──────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── هاست اشتراکی: بدون worker، بدون Redis ────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=public

# ── ایمیل: درایور sync + SMTP خارجی (Brevo — D06) ────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@hosseinyariam.ir"
MAIL_FROM_NAME="${APP_NAME}"

# ── کاربر مدیر ───────────────────────────────────────────────
# ADMIN_EMAIL هم برای ساخت کاربر توسط seeder است و هم فهرستِ مجازِ
# ورود به /admin. خالی بودنش یعنی هیچ‌کس به پنل دسترسی ندارد (شکست امن).
ADMIN_NAME="حسین یاری"
ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_LEVEL=error
